rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isApprovedCitizen() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'approved'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'citizen';
    }

    // Citizen uploads are private and namespaced by UID. Only PDF/JPEG/PNG, max 10 MB.
    match /request-attachments/{uid}/{requestId}/{fileName} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && isApprovedCitizen()
        && requestId.size() > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
      allow update, delete: if isAdmin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}